    "typecheck": "vue-tsc -b",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "bench": "tsx bench/run-bench.ts",
    "models": "node scripts/fetch-models.mjs"
  },
  "dependencies": {
    "comlink": "^4.4.2",
    "fflate": "^0.8.3",
    "idb-keyval": "^6.3.0",
