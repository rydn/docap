{
  "name": "docap",
  "private": true,
  "version": "0.1.0",
  "description": "Hands-free document capture: detect, auto-capture, crop and deskew documents in the browser.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
